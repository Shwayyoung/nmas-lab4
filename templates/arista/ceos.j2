no aaa root
!
management api http-commands
   no shutdown
!
{% if dhcp_relay_information_option | default(false) %}
ip dhcp relay information option
!
{% endif %}
no service interface inactive port-id allocation disabled
!
service routing protocols model multi-agent
!
{% if logging_trap is defined %}
logging trap {{ logging_trap }}
{% endif %}
{% if logging_host is defined %}
logging host {{ logging_host }}
{% else %}
logging host 172.20.20.1
{% endif %}
logging local-interface Management0
!
hostname {{ hostname }}
!
snmp-server contact {{ snmp_contact | default('NMAS') }}
snmp-server location {{ snmp_location | default('5840-Lab') }}
snmp-server enable traps snmp link-down
snmp-server enable traps snmp link-up
!
spanning-tree mode {{ spanning_tree_mode | default('mstp') }}
!
system l1
   unsupported speed action error
   unsupported error-correction action error
!
{% if vlans is defined %}
{% for vlan in vlans %}
vlan {{ vlan.id }}
{% if vlan.name is defined %}
   name {{ vlan.name }}
{% endif %}
!
{% endfor %}
{% endif %}
management api gnmi
   transport grpc default
!
management api netconf
   transport ssh default
!
{% for intf in interfaces %}
interface {{ intf.name }}
{% if intf.description is defined %}
   description {{ intf.description }}
{% endif %}
{% if intf.mode is defined and intf.mode == "routed" %}
   no switchport
{% elif intf.mode is defined and intf.mode == "access" %}
   switchport access vlan {{ intf.access_vlan }}
{% elif intf.mode is defined and intf.mode == "trunk" %}
{% if intf.allowed_vlans is defined %}
   switchport trunk allowed vlan {{ intf.allowed_vlans }}
{% endif %}
   switchport mode trunk
{% endif %}
{% if intf.ipv4 is defined %}
   ip address {{ intf.ipv4 }}
{% endif %}
{% if intf.ipv6 is defined %}
   ipv6 address {{ intf.ipv6 }}
{% endif %}
{% if intf.ip_helper is defined %}
{% if intf.ip_helper_source is defined %}
   ip helper-address {{ intf.ip_helper }} source-interface {{ intf.ip_helper_source }}
{% else %}
   ip helper-address {{ intf.ip_helper }}
{% endif %}
{% endif %}
{% if intf.isis is defined %}
   isis enable {{ intf.isis }}
{% if intf.isis_passive | default(false) %}
   isis passive
{% elif intf.isis_p2p | default(true) %}
   isis network point-to-point
{% endif %}
{% endif %}
{% if intf.ospf_area is defined %}
   ip ospf area {{ intf.ospf_area }}
{% endif %}
{% if intf.ospfv3_process is defined %}
   ipv6 ospf {{ intf.ospfv3_process }} area {{ intf.ospfv3_area | default(intf.ospf_area) }}
{% endif %}
{% if intf.vrrp is defined %}
{% for vrrp in intf.vrrp %}
{% if vrrp.priority is defined %}
   vrrp {{ vrrp.id }} priority-level {{ vrrp.priority }}
{% endif %}
{% if vrrp.ipv4 is defined %}
   vrrp {{ vrrp.id }} ipv4 {{ vrrp.ipv4 }}
{% endif %}
{% if vrrp.ipv6 is defined %}
   vrrp {{ vrrp.id }} ipv6 {{ vrrp.ipv6 }}
{% endif %}
{% endfor %}
{% endif %}
!
{% endfor %}
{% if loopback is defined %}
interface Loopback0
{% if loopback.description is defined %}
   description {{ loopback.description }}
{% elif routing is defined and routing.ospf is defined %}
   description ROUTER_ID
{% endif %}
{% if loopback.ipv4 is defined %}
   ip address {{ loopback.ipv4 }}
{% endif %}
{% if loopback.ipv6 is defined %}
   ipv6 address {{ loopback.ipv6 }}
{% endif %}
{% if loopback.ospf_area is defined %}
   ip ospf area {{ loopback.ospf_area }}
{% elif routing is defined and routing.ospf is defined %}
   ip ospf area 0.0.0.0
{% endif %}
{% if loopback.ospfv3_process is defined %}
   ipv6 ospf {{ loopback.ospfv3_process }} area {{ loopback.ospfv3_area | default('0.0.0.0') }}
{% elif routing is defined and routing.ospf is defined %}
   ipv6 ospf {{ routing.ospf.process }} area 0.0.0.0
{% endif %}
!
{% endif %}
interface Management0
   ip address {{ management.ipv4 }}
{% if management.ipv6 is defined %}
   ipv6 address {{ management.ipv6 }}
{% endif %}
!
{% if svis is defined %}
{% for svi in svis %}
interface Vlan{{ svi.vlan }}
{% if svi.description is defined %}
   description {{ svi.description }}
{% endif %}
{% if svi.ipv4 is defined %}
   ip address {{ svi.ipv4 }}
{% endif %}
{% if svi.ip_helper is defined %}
{% if svi.ip_helper_source is defined %}
   ip helper-address {{ svi.ip_helper }} source-interface {{ svi.ip_helper_source }}
{% else %}
   ip helper-address {{ svi.ip_helper }}
{% endif %}
{% endif %}
{% if svi.ipv6 is defined %}
   ipv6 address {{ svi.ipv6 }}
{% endif %}
{% if svi.isis is defined %}
   isis enable {{ svi.isis }}
{% if svi.isis_passive | default(false) %}
   isis passive
{% elif svi.isis_p2p | default(false) %}
   isis network point-to-point
{% endif %}
{% endif %}
{% if svi.vrrp is defined %}
{% for vrrp in svi.vrrp %}
{% if vrrp.priority is defined %}
   vrrp {{ vrrp.id }} priority-level {{ vrrp.priority }}
{% endif %}
{% if vrrp.ipv4 is defined %}
   vrrp {{ vrrp.id }} ipv4 {{ vrrp.ipv4 }}
{% endif %}
{% if vrrp.ipv6 is defined %}
   vrrp {{ vrrp.id }} ipv6 {{ vrrp.ipv6 }}
{% endif %}
{% endfor %}
{% endif %}
!
{% endfor %}
{% endif %}
ip routing
!
{% if routing is defined and routing.ipv4_prefix_lists is defined %}
{% for name, entries in routing.ipv4_prefix_lists.items() %}
ip prefix-list {{ name }}
{% for entry in entries %}
   {{ entry }}
{% endfor %}
!
{% endfor %}
{% endif %}
{% if routing is defined and routing.ipv6_prefix_lists is defined %}
{% for name, entries in routing.ipv6_prefix_lists.items() %}
ipv6 prefix-list {{ name }}
{% for entry in entries %}
   {{ entry }}
{% endfor %}
!
{% endfor %}
{% endif %}
ipv6 unicast-routing
!
{% if management.gateway_ipv4 is defined %}
ip route 0.0.0.0/0 {{ management.gateway_ipv4 }}
!
{% endif %}
{% if management.gateway_ipv6 is defined %}
ipv6 route ::/0 {{ management.gateway_ipv6 }}
!
{% endif %}
{% if routing is defined and routing.route_maps is defined %}
{% for rm in routing.route_maps %}
route-map {{ rm.name }} {{ rm.action }} {{ rm.sequence }}
{% if rm.match is defined %}
   match {{ rm.match }}
{% endif %}
{% if rm.set is defined %}
   set {{ rm.set }}
{% endif %}
!
{% endfor %}
{% endif %}
{% if routing is defined and routing.isis is defined %}
router isis {{ routing.isis.process }}
   net {{ routing.isis.net }}
{% if routing.isis.level is defined %}
   is-type {{ routing.isis.level }}
{% else %}
   is-type level-2
{% endif %}
{% if routing.isis.redistribute is defined %}
{% for redist in routing.isis.redistribute %}
   redistribute {{ redist }}
{% endfor %}
{% endif %}
   !
   address-family ipv6 unicast
!
{% endif %}
{% if routing is defined and routing.ospf is defined %}
router ospf {{ routing.ospf.process }}
   router-id {{ routing.router_id }}
{% if routing.ospf.redistribute is defined %}
{% for redist in routing.ospf.redistribute %}
   redistribute {{ redist }}
{% endfor %}
{% endif %}
   max-lsa {{ routing.ospf.max_lsa | default(12000) }}
!
{% endif %}
{% if routing is defined and routing.ospfv3 is defined %}
ipv6 router ospf {{ routing.ospfv3.process }}
   router-id {{ routing.router_id }}
{% if routing.ospfv3.redistribute is defined %}
{% for redist in routing.ospfv3.redistribute %}
   redistribute {{ redist }}
{% endfor %}
{% endif %}
!
{% elif routing is defined and routing.ospf is defined %}
ipv6 router ospf {{ routing.ospf.process }}
   router-id {{ routing.router_id }}
{% if routing.ospf.redistribute_ipv6 is defined %}
{% for redist in routing.ospf.redistribute_ipv6 %}
   redistribute {{ redist }}
{% endfor %}
{% endif %}
!
{% endif %}
{% if routing is defined and routing.rip is defined %}
router rip
{% if routing.rip.networks is defined %}
{% for network in routing.rip.networks %}
   network {{ network }}
{% endfor %}
{% endif %}
{% if routing.rip.redistribute is defined %}
{% for redist in routing.rip.redistribute %}
   redistribute {{ redist }}
{% endfor %}
{% endif %}
   no shutdown
!
{% endif %}
end